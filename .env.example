# Copy this file to .env and fill in your key:  cp .env.example .env   (Windows: copy .env.example .env)
# .env is git-ignored and docker-ignored. Never commit a real key.

GROQ_API_KEY=your-key-here
# Model used by --llm groq. Check Groq's current model list if a call is rejected.
GROQ_MODEL=openai/gpt-oss-20b
